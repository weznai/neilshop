# GLOWMAG Docker Compose 环境变量样例 —— 对齐《高可用架构设计-v2》§7.0 方案零
# 用法：cp .env.example .env 后填写；.env 含密钥，永不提交仓库（已列入 .dockerignore/.gitignore 纪律）

# MySQL root 密码（仅容器初始化与运维进库使用）
# 生成示例：openssl rand -hex 16
GM_MYSQL_ROOT_PASSWORD=change-me-root

# glowmag 业务库密码（compose 自动组装 GM_DB：
#   mysql+pymysql://glowmag:<此密码>@mysql:3306/glowmag?charset=utf8mb4）
# 注意：避开 @ : / ? # 等在 URL 中需编码的字符；如必须使用，请 URL 编码后同步修改
# docker-compose.yml 中 x-glowmag-env 的 GM_DB
# 生成示例：openssl rand -hex 16
GM_MYSQL_PASSWORD=change-me-app

# JWT 签名密钥 —— 泄露即全体用户 token 可被伪造
# 生成示例：openssl rand -hex 32
GM_JWT_SECRET=please-run-openssl-rand-hex-32

# Stripe 密钥（可选，当前 MVP 支付 Mock；接入 Stripe 时填 sk_live_/sk_test_ 开头密钥，
# 且需在镜像中补装 stripe 包 —— 见 server/app/services/payment_provider.py）
GM_STRIPE_KEY=

# Stripe Webhook 签名密钥（可选；与 GM_STRIPE_KEY 配套，用于校验 webhook 回调）
GM_STRIPE_WEBHOOK_SECRET=

# Stripe Klarna 开关（可选，1=PaymentIntent 附 Klarna 支付方式；默认 0）
GM_STRIPE_KLARNA=0

# PayPal（可选；CLIENT_ID+SECRET 齐全且 httpx 可用时自动启用 PayPalProvider，优先级 stripe > paypal > mock）
GM_PAYPAL_CLIENT_ID=
GM_PAYPAL_SECRET=
# PayPal API 基址（默认沙箱；生产填 https://api-m.paypal.com）
GM_PAYPAL_BASE=

# 时区（api/mysql/worker 容器内日志时间戳）
TZ=Asia/Shanghai

# —— 以下仅本机开发直跑（不走 Docker）时使用，容器部署无需取消注释 ——
# GM_DB=mysql+pymysql://glowmag:change-me-app@127.0.0.1:3306/glowmag?charset=utf8mb4

# ===== 前后台分离新增（v0.2） =====
# 后台会话时效（小时，默认 12；前后台拆域后建议再收紧）
GM_ADMIN_TOKEN_HOURS=12

# CORS 白名单（逗号分隔完整 origin）。同源部署留空 = 不启用 CORS（最安全）；
# 后台拆独立域名（如 https://admin.example.com 调 https://api.example.com）时必填
GM_ALLOWED_ORIGINS=

# Cookie Secure 标记：prod 默认开（HTTPS）；本地 HTTP 调试可设 0
GM_COOKIE_SECURE=

# Cookie 会话通道（默认 1 开；设 0 关闭登录 Cookie 仅走 Bearer —— 纯 API 网关/测试场景用）
GM_COOKIE_AUTH=1

# 前台会员 token 时效（天，默认 7；后台会话见上方 GM_ADMIN_TOKEN_HOURS）
GM_TOKEN_DAYS=7

# 热路径只读缓存（默认关；GM_CACHE=1 开启，GM_CACHE_TTL 缓存秒数默认 30）
GM_CACHE=
GM_CACHE_TTL=30

# Cloudflare Tunnel（可选，deploy.md §2.1 方案 A：compose 追加 tunnel 服务后填入）
CF_TUNNEL_TOKEN=
