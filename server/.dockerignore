# GLOWMAG 构建上下文裁剪（上下文 = 仓库根）
# Docker 仅读取上下文根的 .dockerignore —— 首次部署时执行：
#   cp server/.dockerignore .dockerignore
# （仓库根不落 .dockerignore，避免与"只许新建 server/.dockerignore"的交付约束冲突）

# 版本库与文档（不进镜像）
.git
.gitignore
*.md

# 密钥（绝不进构建上下文）
.env
.env.*
*.pem
*.key

# Python 产物与虚拟环境（.venv 体积大且平台相关）
**/__pycache__/
**/*.pyc
server/.venv/
server/tests/
server/test_*.sqlite*

# 前端/部署杂物
web/*/node_modules/
web/dist
uvicorn.pid
scripts/
